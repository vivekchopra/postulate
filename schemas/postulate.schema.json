{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Postulate Spec",
  "type": "object",
  "required": ["feature", "contract", "bdd"],
  "properties": {
    "feature": { "type": "string", "minLength": 1 },
    "owner": { "type": "string" },
    "risk": {
      "enum": ["low", "medium", "high", "critical"],
      "default": "medium"
    },
    "contract": {
      "type": "object",
      "required": ["preconditions", "postconditions"],
      "properties": {
        "preconditions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "postconditions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "failure_cases": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "bdd": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "given": { "type": "object", "default": {} },
          "when": { "type": "object", "default": {} },
          "then": { "type": "object", "default": {} }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "test_mapping": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "default": {}
    },
    "correctness_argument": { "type": "string" }
  }
}
